# Copy to the ignored root keystore.properties and fill values locally.
# Keep the actual keystore outside source control and retain it for future updates.
# Absolute paths should use forward slashes; relative paths resolve from project root.
storeFile=.signing/jayaguna-release.jks
storePassword=REPLACE_LOCALLY
keyAlias=jayaguna
keyPassword=REPLACE_LOCALLY

# CI can supply these environment variables instead of this local file:
# JTP_RELEASE_STORE_FILE, JTP_RELEASE_STORE_PASSWORD,
# JTP_RELEASE_KEY_ALIAS, JTP_RELEASE_KEY_PASSWORD
# Restore the same private .signing folder on another laptop; never generate a replacement key.
# Use python3 scripts/build.py release (Windows: py scripts/build.py release).
# Native Firebase/Drive does not require backendBaseUrl; it is only for the optional legacy API.
