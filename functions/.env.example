# Backend only. Copy to functions/.env and fill real values; never put these in APK/web.
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
FIREBASE_PROJECT_ID=jayagunatehnikperkasa
MEDIA_PROVIDER=drive
BACKEND_PUBLIC_URL=http://localhost:8787
ALLOWED_ORIGINS=https://jayagunatehnikperkasa.com,http://localhost:5173
# Login uses Firebase Auth and Firestore roles; device attestation is optional.
ENFORCE_APP_CHECK=false
TRUST_PROXY_HOPS=0
# Application Default Credentials on the server. Prefer workload identity/attached IAM.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/backend-service-account.json
GOOGLE_DRIVE_PRODUCTS_FOLDER_ID=
GOOGLE_DRIVE_PARTNERS_FOLDER_ID=
# Existing portfolio folders; central profile rejects changes to company folder IDs.
GOOGLE_DRIVE_PORTFOLIO_RESIDENTIAL_FOLDER_ID=1kOqO3wgNmUCujrhb1tqY3kB_kG7jTEjx
GOOGLE_DRIVE_PORTFOLIO_CORPORATE_FOLDER_ID=10Z9US8nxqTV5AkJrRrEURRsWNhOpvHvK
GOOGLE_DRIVE_ACCOUNT_EMAIL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/api/drive/oauth/callback
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key in the server's secret store; losing it requires reconnecting Drive.
DRIVE_TOKEN_ENCRYPTION_KEY=
# Server-side access-request notifications; the recipient is fixed in source.
RESEND_API_KEY=
ACCESS_REQUEST_FROM=
